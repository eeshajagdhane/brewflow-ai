# Runtime does not need an API key. The orchestrator, tools, RAG, and UI
# all run locally against the CSVs in data/raw/.
#
# An OpenAI-compatible key is only required if you invoke the optional LLM
# client in utils/connect.py (the skill contracts describe that path; the
# console does not call it).

# OPENAI_API_KEY=your-key-here
# OPENAI_API_BASE=https://api.openai.com/v1
